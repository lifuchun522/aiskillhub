{
  "version": "1.0",
  "note": "授权清单。authorized=true 且 risk=low 的条目才允许被清理接口删除。占位符: %HOME% %LOCAL% %ROAM% ，支持 * 通配。",
  "entries": [
    {
      "id": "local-temp",
      "pattern": "%LOCAL%/Temp",
      "risk": "low",
      "category": "临时文件",
      "desc": "用户临时目录",
      "impact": "清理后：占用中的临时文件会被跳过；未保存的临时工作可能丢失。目录会由系统与程序自动重建。",
      "authorized": true,
      "mode": "clear"
    },
    {
      "id": "uv-cache",
      "pattern": "%LOCAL%/uv/cache",
      "risk": "low",
      "category": "包缓存",
      "desc": "uv 包管理下载缓存",
      "impact": "清理后：下次 uv 安装依赖需重新下载。等价命令 uv cache clean。",
      "authorized": true,
      "mode": "clear"
    },
    {
