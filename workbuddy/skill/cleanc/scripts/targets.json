      "authorized": false,
      "mode": "clear",
      "hint": "PowerShell: Clear-RecycleBin -Force"
    },

    {
      "id": "docker-wsl",
      "pattern": "%LOCAL%/Docker/wsl",
      "risk": "mid",
      "category": "容器",
      "desc": "Docker/WSL 虚拟磁盘 (ext4.vhdx)",
      "impact": "清理后影响：直接删目录会毁掉全部镜像与容器数据，且 ext4.vhdx 不会自动回收。正确路径是先 docker system prune -a 释放内部空间，再在 WSL 内压缩 vhdx（fstrim + Optimize-VHD），否则磁盘空间不下降。未提交的容器数据会丢失，已推送镜像可重新拉取。",
      "authorized": false,
      "mode": "manual",
      "hint": "docker system prune -a --volumes  然后 wsl --shutdown; Optimize-VHD -Path <vhdx> -Mode Full"
    },
    {
      "id": "jetbrains-index",
      "pattern": "%LOCAL%/JetBrains/*/index",
      "risk": "mid",
      "category": "IDE缓存",
      "desc": "JetBrains 项目索引",
      "impact": "清理后影响：重新打开项目时全量重建索引，期间 CPU 占用高、代码跳转/补全/全局搜索不可用，大项目通常 10~40 分钟。不丢失代码、设置与插件配置；索引本就是可重建产物。",
      "authorized": false,
      "mode": "manual",
      "hint": "推荐在 IDE 内 File > Invalidate Caches / Restart 执行，比直接删目录安全"
    },
    {
      "id": "jetbrains-caches",
      "pattern": "%LOCAL%/JetBrains/*/caches",
      "risk": "mid",
      "category": "IDE缓存",
      "desc": "JetBrains 本地缓存",
      "impact": "清理后影响：首次启动变慢，部分本地历史与缓存重建。项目代码、VCS 配置、插件不受影响。",
      "authorized": false,
      "mode": "manual",
      "hint": "优先用 File > Invalidate Caches / Restart"
    },
